# ─────────────────────────────────────────────────────────────
# DERMASENSE — variables de entorno
# Copiar a .env.local y completar. NUNCA subir .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase — públicas (protegidas por Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase — SOLO SERVIDOR. Omite RLS. Nunca con prefijo NEXT_PUBLIC_.
# Solo se usa para migraciones y seed.
SUPABASE_SERVICE_ROLE_KEY=

# Backend Python (DERMASENSE-BACKEND) — SOLO SERVIDOR
# Aqui vive la IA: el prompt, el modelo y el manejo de fallos. Este proyecto ya
# NO llama a Anthropic directamente; /api/report actua de proxy.
BACKEND_URL=http://localhost:8000

# ANTHROPIC_API_KEY ya no se usa aqui. La clave del proveedor de IA vive en el
# repositorio del backend, que es quien hace la llamada.

# Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Python (FastAPI) — ver docs/API_CONTRACT.md
NEXT_PUBLIC_PY_API_URL=
